{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/deny-migration-edits.py",
        "matcher": "Write|Delete|StrReplace|Edit|Shell",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/deny-migration-edits.py",
        "failClosed": true
      }
    ]
  }
}
