# Copy to deploy/env/copilot.env

LOG_LEVEL=info
ENVIRONMENT=production
API_ORIGIN=http://api:8000

MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=8002

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=networthdb
POSTGRES_SSLMODE=require
POSTGRES_RO_USER=networthdb_readonly
POSTGRES_RO_PASSWORD=CHANGE_ME_readonly_password

