# Copy to deploy/env/api.env

# Application
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=production
CORS_ALLOW_ORIGINS=https://networthdb.example.com

# Database (service name on the Compose network)
POSTGRES_USER=networthdb
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=networthdb
POSTGRES_SSLMODE=require
POSTGRES_RO_USER=networthdb_readonly
POSTGRES_RO_PASSWORD=CHANGE_ME_readonly_password
KVSTORE_URL=redis://valkey:6379/0

# Sessions
SESSION_TTL=15m
REFRESH_TTL=720h
MFA_CHALLENGE_TTL=5m
# 32-byte secret: openssl rand -hex 32
MFA_SECRET=CHANGE_ME_64_hex_chars_mfa_secret________________________________
MFA_MAX_FAILURES=5
MFA_LOCKOUT_TTL=15m
MFA_TOTP_SKEW=1
# MFA_REQUIRED_ROLES=administrator,manager,user

# WebAuthn (public HTTPS origin and RP ID)
WEBAUTHN_RP_DISPLAY_NAME=NetworthDB
WEBAUTHN_RP_ID=networthdb.example.com
WEBAUTHN_RP_ORIGINS=https://networthdb.example.com

# Account recovery
RECOVERY_APP_BASE_URL=https://networthdb.example.com
# RECOVERY_PASSWORD_TOKEN_TTL=1h
# RECOVERY_ADVANCED_TOKEN_TTL=30m
EMAIL_CHANNEL=smtp
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_FROM=networthdb@example.com

# Storage (volume mount path inside the API container)
# 32-byte key: openssl rand -hex 32
FILESTORE_SECRET=CHANGE_ME_64_hex_chars_filestore_secret________________________
FILESTORE_PATH=/var/lib/networthdb
BACKUP_MAX_UPLOAD_BYTES=536870912
JOBS_MAX_WORKERS=10

# Advanced
# AUTH_RATE_LIMIT=20
# AUTH_RATE_WINDOW=1m
DISABLE_ADVANCED_SECURITY=false

# First administrator (only when the users table is empty). Remove password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_bootstrap_password
