{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"],
    "paths": {
      "@api/*": ["./src/apps/api/src/*"],
      "@bootstrap/*": ["./src/packages/bootstrap/src/*"],
      "@core/*": ["./src/packages/core/src/*"],
      "@database/*": ["./src/packages/database/src/*"],
      "@encryption/*": ["./src/packages/encryption/src/*"],
      "@logger/*": ["./src/packages/logger/src/*"],
      "@auth/*": ["./src/packages/auth/src/*"],
      "@middleware/*": ["./src/packages/middleware/src/*"],
      "@notifications/*": ["./src/packages/notifications/src/*"],
      "@platform/*": ["./src/packages/platform/src/*"],
      "@statements/*": ["./src/packages/statements/src/*"],
      "@web/*": ["./src/apps/web/src/*"],
      "@mcp/*": ["./src/packages/mcp/src/*"],
      "@copilot/*": ["./src/apps/copilot/src/*"],
      // Tests
      "@tests/api/*": ["./src/apps/api/tests/*"],
      "@tests/auth/*": ["./src/packages/auth/tests/*"],
      "@tests/bootstrap/*": ["./src/packages/bootstrap/tests/*"],
      "@tests/database/*": ["./src/packages/database/tests/*"],
      "@tests/encryption/*": ["./src/packages/encryption/tests/*"],
      "@tests/logger/*": ["./src/packages/logger/tests/*"],
      "@tests/middleware/*": ["./src/packages/middleware/tests/*"],
      "@tests/notifications/*": ["./src/packages/notifications/tests/*"],
      "@tests/platform/*": ["./src/packages/platform/tests/*"],
      "@tests/statements/*": ["./src/packages/statements/tests/*"],
      "@tests/web/*": ["./src/apps/web/tests/*"],
      "@tests/mcp/*": ["./src/packages/mcp/tests/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
