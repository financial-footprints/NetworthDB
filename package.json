{
  "name": "networthdb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @ndb/api --filter @ndb/web --filter @ndb/copilot dev",
    "format": "biome check --write . && markdownlint **/*.md --fix",
    "test": "bun run --parallel --workspaces --if-present test",
    "type-check": "bun run --parallel --workspaces type-check",
    "validate:card-catalog": "bun run --filter @ndb/statements validate:card-catalog"
  },
  "overrides": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "dependency-cruiser": "^18.4.0",
    "markdownlint-cli": "^0.49.1",
    "@usebruno/cli": "^4.1.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "~7.0.2"
  }
}
