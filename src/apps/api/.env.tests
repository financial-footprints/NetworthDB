# Application
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=info
ENVIRONMENT=local
SEED_RESET_USER_DATA=true

# Database
POSTGRES_USER=networthdb
POSTGRES_PASSWORD=networthdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5451
POSTGRES_DATABASE=networthdb
POSTGRES_SSLMODE=disable
POSTGRES_RO_USER=networthdb_readonly
POSTGRES_RO_PASSWORD=networthdb_readonly
KVSTORE_URL=redis://127.0.0.1:6379/0

## Sessions
SESSION_TTL=15m
REFRESH_TTL=720h
MFA_CHALLENGE_TTL=5m
MFA_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
MFA_MAX_FAILURES=5
MFA_LOCKOUT_TTL=15m
MFA_TOTP_SKEW=1
# MFA_REQUIRED_ROLES=administrator,manager,user

## WebAuthn
WEBAUTHN_RP_DISPLAY_NAME=NetworthDB
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

## Account Recovery
RECOVERY_APP_BASE_URL=http://localhost:3000
EMAIL_CHANNEL=console

## Storage
FILESTORE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

## Pipeline
FILESTORE_PATH=/tmp/networthdb-test
JOBS_MAX_WORKERS=2

## Advanced
AUTH_RATE_LIMIT=1000
AUTH_RATE_WINDOW=1m
