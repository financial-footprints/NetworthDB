# Application
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=local

# Postgres (docker-compose maps 5451 -> 5432)
POSTGRES_USER=networthdb
POSTGRES_PASSWORD=networthdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5451
POSTGRES_DATABASE=networthdb
POSTGRES_SSLMODE=disable

# Session TTLs
SESSION_TTL=15m
REFRESH_TTL=720h
MFA_CHALLENGE_TTL=5m

# Optional: comma-separated exact origins (empty = no cross-origin)
# CORS_ALLOW_ORIGINS=http://localhost:3000
