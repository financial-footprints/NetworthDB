{
  "name": "@ndb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch --no-clear-screen --env-file .env src/server.ts",
    "start": "bun --env-file .env src/server.ts",
    "start:test": "bun --env-file .env.tests src/server.ts",
    "test": "bun test --env-file .env.tests src tests",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ndb/auth": "workspace:*",
    "@ndb/bootstrap": "workspace:*",
    "@ndb/core": "workspace:*",
    "@ndb/middleware": "workspace:*",
    "@ndb/platform": "workspace:*",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/swagger-ui": "^0.5.0",
    "hono": "^4.13.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ndb/logger": "workspace:*",
    "@types/bun": "^1.4.1",
    "otpauth": "^9.4.0"
  }
}
