meta {
  name: 17-07 Create Transaction
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/v1/accounts/{{ledgerAccountId}}/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SESSION_TOKEN}}
}

body:json {
  {
    "date": "2024-06-15",
    "amount": 2500,
    "sourceAccountId": "{{ledgerAccountId}}",
    "destinationAccountId": "{{expenseAccountId}}",
    "description": "Bruno spend"
  }
}

script:post-response {
  bru.setVar("ledgerTransactionId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.amount: eq 2500
}
