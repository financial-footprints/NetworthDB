meta {
  name: 17-02 Create Bank Account
  type: http
  seq: 2
}

docs {
  **Endpoint:** `POST /api/v1/accounts`

  **This test verifies:** Seed user can create an instrument account for transaction API tests.
}

post {
  url: {{BASE_URL}}/api/v1/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SESSION_TOKEN}}
}

body:json {
  {
    "bank": "ICICI",
    "accountType": "bank",
    "openingDate": "2019-03-01",
    "accountNumber": "abc.def",
    "passwords": []
  }
}

script:post-response {
  bru.setVar("ledgerAccountId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.accountType: eq bank
}
