meta {
  name: 07-06 Patch Display Name
  type: http
  seq: 6
}

patch {
  url: {{BASE_URL}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{vaultSessionToken}}
}

body:json {
  {
    "displayName": "abc.def"
  }
}

assert {
  res.status: eq 200
  res.body.data: eq null
}

docs {
  **Endpoint:** `PATCH /api/v1/users/me`

  **This test verifies:** User can set display_name after vault exists.
}
