meta {
  name: 07-04 Vault Initialize
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/v1/users/me/vault/initialize
  body: json
  auth: bearer
}

auth:bearer {
  token: {{vaultSessionToken}}
}

body:json {
  {
    "slots": [
      {
        "slotType": "password",
        "salt": "AQIDBAUGBwgJCgsMDQ4PEA",
        "wrapBlob": "abc.def",
        "password": "{{vaultPassword}}"
      }
    ]
  }
}

script:post-response {
  bru.setVar("vaultSlotId", res.body.data.vaultSlots[0].id);
}

assert {
  res.status: eq 201
  res.body.data.vaultSlots: isArray
}

docs {
  **Endpoint:** `POST /api/v1/users/me/vault/initialize`

  **This test verifies:** User can initialize vault with a password slot.
}
