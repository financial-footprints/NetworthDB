meta {
  name: 07-02 Register Vault User
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminSessionToken}}
}

body:json {
  {
    "username": "{{vaultUsername}}",
    "password": "{{vaultPassword}}"
  }
}

assert {
  res.status: eq 201
}

docs {
  **Endpoint:** `POST /api/v1/users`

  **This test verifies:** Register user for vault tests.
}
