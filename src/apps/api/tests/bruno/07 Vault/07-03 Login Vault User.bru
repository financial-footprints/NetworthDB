meta {
  name: 07-03 Login Vault User
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{vaultUsername}}",
    "password": "{{vaultPassword}}"
  }
}

script:post-response {
  bru.setVar("vaultSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Login before vault initialization.
}
