meta {
  name: 07-01 Admin Login Setup
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar("vaultUsername", `bruno_vault_${suffix}`);
  bru.setVar("vaultPassword", "password123");
}

script:post-response {
  bru.setVar("adminSessionToken", res.body.data.sessionToken);
}

body:json {
  {
    "username": "admin",
    "password": "admin"
  }
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Administrator session for vault tests.
}
