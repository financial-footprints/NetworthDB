meta {
  name: 07-10 Reject Plaintext Recovery Secret
  type: http
  seq: 10
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{phraseUsername}}",
    "password": "{{phrasePassword}}"
  }
}

script:post-response {
  bru.setVar("phraseSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Login phrase test user before initialize rejection test.
}
