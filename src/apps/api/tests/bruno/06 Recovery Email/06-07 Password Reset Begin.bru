meta {
  name: 06-07 Password Reset Begin
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/v1/auth/recovery/password/begin
  body: json
  auth: none
}

body:json {
  {
    "username": "{{recoveryEmailUsername}}",
    "email": "{{recoveryEmailAddress}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.message: isDefined
}

docs {
  **Endpoint:** `POST /api/v1/auth/recovery/password/begin`

  **This test verifies:** Password reset begin always returns a generic success message.
}
