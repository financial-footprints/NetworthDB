meta {
  name: 06-03 Login Recovery Email User
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{recoveryEmailUsername}}",
    "password": "{{recoveryEmailPassword}}"
  }
}

script:post-response {
  bru.setVar("recoveryEmailSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Login before recovery email enrollment.
}
