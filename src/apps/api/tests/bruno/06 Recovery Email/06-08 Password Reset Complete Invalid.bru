meta {
  name: 06-08 Password Reset Complete Invalid
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/v1/auth/recovery/password/complete
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-valid-reset-token",
    "newPassword": "newpassword456"
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}

docs {
  **Endpoint:** `POST /api/v1/auth/recovery/password/complete`

  **This test verifies:** Invalid reset token returns 400.
}
