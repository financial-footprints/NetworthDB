meta {
  name: 06-01 Admin Login Setup
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar("recoveryEmailUsername", `bruno_remail_${suffix}`);
  bru.setVar("recoveryEmailPassword", "password123");
  bru.setVar("recoveryEmailAddress", `bruno_remail_${suffix}@example.com`);
}

script:post-response {
  bru.setVar("adminSessionToken", res.body.data.session_token);
}

body:json {
  {
    "username": "admin",
    "password": "admin"
  }
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Administrator session for recovery email tests.
}
