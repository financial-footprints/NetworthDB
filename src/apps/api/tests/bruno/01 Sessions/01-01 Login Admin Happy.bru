meta {
  name: 01-01 Login Admin Happy
  type: http
  seq: 1
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Seeded administrator can log in and receives session tokens.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin"
  }
}

script:post-response {
  bru.setVar("sessionToken", res.body.data.sessionToken);
  bru.setVar("refreshToken", res.body.data.refreshToken);
}

assert {
  res.status: eq 200
  res.body.data.sessionToken: isDefined
  res.body.data.refreshToken: isDefined
}
