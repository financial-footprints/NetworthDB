meta {
  name: 01-02 Login Bad Password
  type: http
  seq: 2
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Invalid credentials return 401 Unauthorized.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.error: isDefined
  res.body.code: isDefined
}
