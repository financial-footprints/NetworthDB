meta {
  name: 01-04 Refresh Happy
  type: http
  seq: 4
}

docs {
  **Endpoint:** `POST /api/v1/auth/refresh`

  **This test verifies:** A valid refresh token rotates the session pair.
}

post {
  url: {{BASE_URL}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  bru.setVar("sessionToken", res.body.data.session_token);
  bru.setVar("refreshToken", res.body.data.refresh_token);
}

assert {
  res.status: eq 200
  res.body.data.session_token: isDefined
  res.body.data.refresh_token: isDefined
  res.body.errors: isEmpty
}
