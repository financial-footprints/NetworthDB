meta {
  name: 01-12 Me User Happy
  type: http
  seq: 12
}

docs {
  **Endpoint:** `GET /api/v1/users/me`

  **This test verifies:** Authenticated user receives profile data.
}

get {
  url: {{BASE_URL}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userSessionToken}}
}

assert {
  res.status: eq 200
  res.body.data.username: eq {{seedUserUsername}}
  res.body.data.role: eq user
}
