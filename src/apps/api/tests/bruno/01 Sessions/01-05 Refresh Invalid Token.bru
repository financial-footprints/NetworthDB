meta {
  name: 01-05 Refresh Invalid Token
  type: http
  seq: 5
}

docs {
  **Endpoint:** `POST /api/v1/auth/refresh`

  **This test verifies:** An invalid refresh token returns 401.
}

post {
  url: {{BASE_URL}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "not-a-valid-refresh-token"
  }
}

assert {
  res.status: eq 401
  res.body.error: isDefined
}
