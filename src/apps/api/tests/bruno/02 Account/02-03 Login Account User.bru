meta {
  name: 02-03 Login Account User
  type: http
  seq: 3
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Newly registered user can log in.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{accountUsername}}",
    "password": "{{accountPassword}}"
  }
}

script:post-response {
  bru.setVar("accountSessionToken", res.body.data.session_token);
  bru.setVar("accountRefreshToken", res.body.data.refresh_token);
}

assert {
  res.status: eq 200
  res.body.data.session_token: isDefined
}
