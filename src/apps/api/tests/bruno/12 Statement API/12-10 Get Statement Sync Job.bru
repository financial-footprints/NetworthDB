meta {
  name: 12-10 Get Statement Sync Job
  type: http
  seq: 10
}

script:pre-request {
  const { waitForJob } = require("./lib/bruno-jobs/wait-for-job.cjs");
  await waitForJob({
    baseUrl: bru.getEnvVar("BASE_URL"),
    token: bru.getVar("statementSessionToken"),
    jobId: bru.getVar("statementSyncJobId"),
    acceptStatuses: ["failed", "completed", "cancelled"],
  });
}

get {
  url: {{BASE_URL}}/api/v1/jobs/{{statementSyncJobId}}
  auth: bearer
}

auth:bearer {
  token: {{statementSessionToken}}
}

script:post-response {
  const warnings = res.getBody().data?.output?.warnings ?? [];
  const extractFailed = warnings.find((row) => row.kind === "extract.failed");
  if (!extractFailed) {
    throw new Error("expected extract.failed warning");
  }
  if (!String(extractFailed.message).includes("profile directory not found")) {
    throw new Error(`unexpected extract message: ${extractFailed.message}`);
  }
}

assert {
  res.status: eq 200
  res.body.data.status: eq completed
}
