meta {
  name: 12-01 Login User
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "usher",
    "password": "admin"
  }
}

script:post-response {
  bru.setVar("statementSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}
