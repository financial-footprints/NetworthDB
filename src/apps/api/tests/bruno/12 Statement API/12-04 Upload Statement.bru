meta {
  name: 12-04 Upload Statement
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/v1/accounts/files/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{statementSessionToken}}
}

body:multipart-form {
  account_id: {{statementAccountId}}
  format: pdf
  covered_month: 2024-01
  file: @file(./11 Jobs/fixtures/statement.pdf)
}

script:post-response {
  bru.setVar("uploadJobId", res.body.data.id);
}

assert {
  res.status: eq 202
}
