meta {
  name: 09-01 Login User
  type: http
  seq: 1
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Session for financial account CRUD as seeded user `usher`.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "usher",
    "password": "admin"
  }
}

script:post-response {
  bru.setVar("accountsSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
  res.body.data.session_token: isDefined
}
