meta {
  name: 09-03 Create Bank Account
  type: http
  seq: 3
}

docs {
  **Endpoint:** `POST /api/v1/accounts`
}

post {
  url: {{BASE_URL}}/api/v1/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountsSessionToken}}
}

body:json {
  {
    "bank": "ICICI",
    "account_type": "bank_account",
    "opening_date": "2019-03-01",
    "account_number": "abc.def",
    "passwords": []
  }
}

script:post-response {
  bru.setVar("bankAccountId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.account_type: eq bank_account
}
