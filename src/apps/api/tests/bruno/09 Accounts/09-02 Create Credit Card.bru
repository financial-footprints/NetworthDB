meta {
  name: 09-02 Create Credit Card
  type: http
  seq: 2
}

docs {
  **Endpoint:** `POST /api/v1/accounts`
}

post {
  url: {{BASE_URL}}/api/v1/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountsSessionToken}}
}

body:json {
  {
    "bank": "HDFC",
    "variant": "Regalia",
    "accountType": "credit_card",
    "openingDate": "2020-01-15",
    "accountNumber": "abc.def",
    "passwords": ["statement-secret"]
  }
}

script:post-response {
  bru.setVar("creditCardAccountId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.accountType: eq credit_card
  res.body.data.hasPasswords: eq true
}
