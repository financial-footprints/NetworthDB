meta {
  name: 09-07 Patch Account
  type: http
  seq: 7
}

docs {
  **Endpoint:** `PATCH /api/v1/accounts/:id`
}

patch {
  url: {{BASE_URL}}/api/v1/accounts/{{creditCardAccountId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountsSessionToken}}
}

body:json {
  {
    "bank": "HDFC Bank"
  }
}

assert {
  res.status: eq 200
  res.body.data.bank: eq "HDFC Bank"
  res.body.data.hasPasswords: eq true
}
