meta {
  name: 09-05 List Filtered
  type: http
  seq: 5
}

docs {
  **Endpoint:** `GET /api/v1/accounts?accountType=credit_card`
}

get {
  url: {{BASE_URL}}/api/v1/accounts?accountType=credit_card
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accountsSessionToken}}
}

assert {
  res.status: eq 200
  res.body.items[0].accountType: eq credit_card
}
