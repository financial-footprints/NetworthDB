meta {
  name: 15-03 Create Rule Group
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/rule-groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SESSION_TOKEN}}
}

body:json {
  {
    "title": "Bruno Group"
  }
}

script:post-response {
  bru.setVar("RULE_GROUP_ID", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.title: eq Bruno Group
}
