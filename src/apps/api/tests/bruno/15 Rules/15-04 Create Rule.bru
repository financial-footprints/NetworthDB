meta {
  name: 15-04 Create Rule
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/v1/rules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SESSION_TOKEN}}
}

body:json {
  {
    "groupId": "{{RULE_GROUP_ID}}",
    "title": "Bruno Rule",
    "when": {
      "op": "and",
      "items": [
        {
          "type": "description_contains",
          "value": "coffee"
        }
      ]
    },
    "actions": [
      {
        "type": "clear_category"
      }
    ]
  }
}

script:post-response {
  bru.setVar("ruleId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.title: eq Bruno Rule
  res.body.data.groupId: eq {{RULE_GROUP_ID}}
}
