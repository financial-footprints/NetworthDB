meta {
  name: 02-06 Patch Username Happy
  type: http
  seq: 6
}

docs {
  **Endpoint:** `PATCH /api/v1/users/me`

  **This test verifies:** User can change username with password confirmation.
}

patch {
  url: {{BASE_URL}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountSessionToken}}
}

body:json {
  {
    "username": "{{accountUsername}}_renamed",
    "currentPassword": "{{accountPassword}}"
  }
}

script:post-response {
  bru.setVar("accountUsername", `${bru.getVar("accountUsername")}_renamed`);
  bru.setVar("accountSessionToken", res.body.data.sessionToken);
}

assert {
  res.status: eq 200
  res.body.data.sessionToken: isDefined
}
