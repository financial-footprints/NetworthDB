meta {
  name: 02-04 Change Password Happy
  type: http
  seq: 4
}

docs {
  **Endpoint:** `PATCH /api/v1/users/me`

  **This test verifies:** User can rotate password and receives a new session pair.
}

patch {
  url: {{BASE_URL}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountSessionToken}}
}

body:json {
  {
    "currentPassword": "{{accountPassword}}",
    "newPassword": "newpassword1"
  }
}

script:post-response {
  bru.setVar("accountSessionToken", res.body.data.sessionToken);
  bru.setVar("accountPassword", "newpassword1");
}

assert {
  res.status: eq 200
  res.body.data.sessionToken: isDefined
  res.body.data.refreshToken: isDefined
}
