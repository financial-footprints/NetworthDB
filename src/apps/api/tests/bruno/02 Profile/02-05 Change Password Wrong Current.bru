meta {
  name: 02-05 Change Password Wrong Current
  type: http
  seq: 5
}

docs {
  **Endpoint:** `PATCH /api/v1/users/me`

  **This test verifies:** Wrong current password returns 401.
}

patch {
  url: {{BASE_URL}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accountSessionToken}}
}

body:json {
  {
    "currentPassword": "not-the-password",
    "newPassword": "anotherpassword1"
  }
}

assert {
  res.status: eq 401
  res.body.error: isDefined
}
