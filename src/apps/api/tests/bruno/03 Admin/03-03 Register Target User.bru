meta {
  name: 03-03 Register Target User
  type: http
  seq: 3
}

docs {
  **Endpoint:** `POST /api/v1/users`

  **This test verifies:** Administrator can create a user for patch/delete tests.
}

post {
  url: {{BASE_URL}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminSessionToken}}
}

body:json {
  {
    "username": "{{adminTargetUsername}}",
    "password": "password123"
  }
}

script:post-response {
  bru.setVar("adminTargetUserId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.id: isDefined
}
