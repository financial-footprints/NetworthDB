meta {
  name: 03-02 Register Manager
  type: http
  seq: 2
}

docs {
  **Endpoint:** `POST /api/v1/users`

  **This test verifies:** Administrator can create a manager account.
}

post {
  url: {{BASE_URL}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminSessionToken}}
}

body:json {
  {
    "username": "{{adminManagerUsername}}",
    "password": "password123",
    "role": "manager"
  }
}

assert {
  res.status: eq 201
  res.body.data.role: eq manager
}
