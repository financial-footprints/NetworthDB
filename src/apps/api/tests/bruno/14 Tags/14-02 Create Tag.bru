meta {
  name: 14-02 Create Tag
  type: http
  seq: 2
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar("tagName", `Bruno Tag ${suffix}`);
}

post {
  url: {{BASE_URL}}/api/v1/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SESSION_TOKEN}}
}

body:json {
  {
    "name": "{{tagName}}"
  }
}

script:post-response {
  bru.setVar("tagId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.id: isDefined
}
