meta {
  name: 04-02 Register MFA User
  type: http
  seq: 2
}

docs {
  **Endpoint:** `POST /api/v1/users`

  **This test verifies:** Administrator registers a user for MFA enrollment.
}

post {
  url: {{BASE_URL}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminSessionToken}}
}

body:json {
  {
    "username": "{{mfaUsername}}",
    "password": "{{mfaPassword}}"
  }
}

assert {
  res.status: eq 201
}
