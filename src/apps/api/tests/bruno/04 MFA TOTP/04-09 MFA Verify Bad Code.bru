meta {
  name: 04-09 MFA Verify Bad Code
  type: http
  seq: 9
}

docs {
  **Endpoint:** `POST /api/v1/auth/login` then `POST /api/v1/auth/multifactor/verify`

  **This test verifies:** Invalid TOTP code returns 401.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{mfaUsername}}",
    "password": "{{mfaPassword}}"
  }
}

script:post-response {
  bru.setVar("badMfaChallengeToken", res.body.data.multifactor_token);
}

assert {
  res.status: eq 200
}
