meta {
  name: 04-13 TOTP Begin Missing Password
  type: http
  seq: 13
}

docs {
  **Endpoint:** `POST /api/v1/users/me/totp/begin`

  **This test verifies:** Missing password returns 400 when MFA is off.
}

post {
  url: {{BASE_URL}}/api/v1/users/me/totp/begin
  body: json
  auth: bearer
}

auth:bearer {
  token: {{noMfaSessionToken}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}
