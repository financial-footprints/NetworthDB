meta {
  name: 04-03 Login MFA User
  type: http
  seq: 3
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** MFA user can log in before enrollment.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{mfaUsername}}",
    "password": "{{mfaPassword}}"
  }
}

script:post-response {
  bru.setVar("mfaSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}
