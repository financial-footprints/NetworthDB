meta {
  name: 04-10 MFA Verify Bad Code Attempt
  type: http
  seq: 10
}

docs {
  **Endpoint:** `POST /api/v1/auth/multifactor/verify`

  **This test verifies:** Invalid TOTP code returns 401.
}

post {
  url: {{BASE_URL}}/api/v1/auth/multifactor/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{badMfaChallengeToken}}
}

body:json {
  {
    "totp": "000000"
  }
}

assert {
  res.status: eq 401
  res.body.error: isDefined
}
