meta {
  name: 04-07 MFA Verify Happy
  type: http
  seq: 7
}

docs {
  **Endpoint:** `POST /api/v1/auth/multifactor/verify`

  **This test verifies:** Valid TOTP code issues an AAL2 session.
}

post {
  url: {{BASE_URL}}/api/v1/auth/multifactor/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{mfaChallengeToken}}
}

body:json {
  {
    "totp": "{{totpCode}}"
  }
}

script:post-response {
  bru.setVar("mfaSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
  res.body.data.session_token: isDefined
}
