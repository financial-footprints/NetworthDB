meta {
  name: 04-12 TOTP Begin Without Password
  type: http
  seq: 12
}

docs {
  **Endpoint:** `POST /api/v1/auth/login` then `POST /api/v1/users/me/totp/begin`

  **This test verifies:** TOTP begin requires password when MFA is not yet enabled.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{noMfaUsername}}",
    "password": "{{noMfaPassword}}"
  }
}

script:post-response {
  bru.setVar("noMfaSessionToken", res.body.data.sessionToken);
}

assert {
  res.status: eq 200
}
