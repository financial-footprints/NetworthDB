meta {
  name: 04-01 Admin Login Setup
  type: http
  seq: 1
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Administrator session for MFA user registration.
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar("mfaUsername", `bruno_mfa_${suffix}`);
  bru.setVar("mfaPassword", "password123");
}

script:post-response {
  bru.setVar("adminSessionToken", res.body.data.session_token);
}

body:json {
  {
    "username": "admin",
    "password": "admin"
  }
}

assert {
  res.status: eq 200
}
