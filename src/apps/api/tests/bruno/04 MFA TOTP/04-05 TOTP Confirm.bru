meta {
  name: 04-05 TOTP Confirm
  type: http
  seq: 5
}

docs {
  **Endpoint:** `POST /api/v1/users/me/totp/confirm`

  **This test verifies:** User confirms TOTP enrollment and receives an AAL2 session.
}

post {
  url: {{BASE_URL}}/api/v1/users/me/totp/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{mfaSessionToken}}
}

body:json {
  {
    "code": "{{totpCode}}"
  }
}

script:post-response {
  bru.setVar("mfaSessionToken", res.body.data.sessionToken);
}

assert {
  res.status: eq 200
  res.body.data.sessionToken: isDefined
}
