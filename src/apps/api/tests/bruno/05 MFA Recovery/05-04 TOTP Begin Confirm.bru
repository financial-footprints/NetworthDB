meta {
  name: 05-04 TOTP Begin Confirm
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/v1/users/me/totp/begin
  body: json
  auth: bearer
}

auth:bearer {
  token: {{recoverySessionToken}}
}

body:json {
  {
    "password": "{{recoveryPassword}}"
  }
}

script:post-response {
  const uri = res.body.data.uri;
  const secretMatch = /secret=([A-Z2-7]+)/.exec(uri);
  if (!secretMatch?.[1]) {
    throw new Error("missing TOTP secret");
  }
  bru.setVar("recoveryTotpSecret", secretMatch[1]);
  const { generateTotpCode } = require("./lib/bruno-totp/index.cjs");
  bru.setVar("recoveryTotpCode", generateTotpCode(secretMatch[1]));
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/users/me/totp/begin`

  **This test verifies:** Begin TOTP enrollment for recovery code tests.
}
