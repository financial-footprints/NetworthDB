meta {
  name: 05-03 Enroll TOTP
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{recoveryUsername}}",
    "password": "{{recoveryPassword}}"
  }
}

script:post-response {
  bru.setVar("recoverySessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Login before TOTP enrollment.
}
