meta {
  name: 05-08 Verify Recovery Code
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/v1/auth/multifactor/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{recoveryMfaToken}}
}

body:json {
  {
    "recoveryCode": "{{recoveryCode}}"
  }
}

script:post-response {
  bru.setVar("recoverySessionToken", res.body.data.sessionToken);
}

assert {
  res.status: eq 200
  res.body.data.sessionToken: isDefined
}

docs {
  **Endpoint:** `POST /api/v1/auth/multifactor/verify`

  **This test verifies:** Recovery code completes MFA login.
}
