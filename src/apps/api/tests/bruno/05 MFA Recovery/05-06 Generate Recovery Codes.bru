meta {
  name: 05-06 Generate Recovery Codes
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/api/v1/users/me/codes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{recoverySessionToken}}
}

script:pre-request {
  const { generateNextTotpCode } = require("./lib/bruno-totp/index.cjs");
  bru.setVar("recoveryTotpCode", generateNextTotpCode(bru.getVar("recoveryTotpSecret")));
}

body:json {
  {
    "totp": "{{recoveryTotpCode}}"
  }
}

script:post-response {
  bru.setVar("recoveryCode", res.body.data.recoveryCodes[0]);
  bru.setVar("recoveryCodeForDelete", res.body.data.recoveryCodes[1]);
}

assert {
  res.status: eq 200
  res.body.data.recoveryCodes: isArray
}

docs {
  **Endpoint:** `POST /api/v1/users/me/codes`

  **This test verifies:** AAL2 user can generate ten recovery codes.
}
