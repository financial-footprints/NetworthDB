meta {
  name: 11-02 Create Account
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/v1/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jobsSessionToken}}
}

body:json {
  {
    "bank": "onecard",
    "accountType": "credit_card",
    "openingDate": "2020-01-15",
    "accountNumber": "abc.def",
    "passwords": []
  }
}

script:post-response {
  bru.setVar("jobsAccountId", res.body.data.id);
}

assert {
  res.status: eq 201
}
