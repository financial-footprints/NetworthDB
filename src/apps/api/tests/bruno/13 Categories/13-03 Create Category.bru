meta {
  name: 13-03 Create Category
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SESSION_TOKEN}}
}

body:json {
  {
    "name": "Bruno Category",
    "parentId": null
  }
}

script:post-response {
  bru.setVar("categoryId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.name: eq Bruno Category
}
