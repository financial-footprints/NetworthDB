meta {
  name: 10-09 Put Sources Omit Password
  type: http
  seq: 9
}

docs {
  **Endpoint:** `PUT /api/v1/sources`

  Omitting password should keep the existing IMAP password.
}

put {
  url: {{BASE_URL}}/api/v1/sources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{integrationsSessionToken}}
}

body:json {
  {
    "sources": [
      {
        "id": "imap-1",
        "type": "email",
        "label": "Work Gmail",
        "host": "imap.example.test",
        "username": "user@example.test"
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.data.sources[0].hasPassword: eq true
}
