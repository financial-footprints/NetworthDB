meta {
  name: 08-08 Password Only Vault Begin
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/v1/auth/recovery/advanced/begin
  body: json
  auth: none
}

body:json {
  {
    "username": "{{advancedUsername}}",
    "email": "{{advancedEmail}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.message: isDefined
}

docs {
  **Endpoint:** `POST /api/v1/auth/recovery/advanced/begin`

  **This test verifies:** Password-only vault user can begin advanced recovery without WebAuthn.
}
