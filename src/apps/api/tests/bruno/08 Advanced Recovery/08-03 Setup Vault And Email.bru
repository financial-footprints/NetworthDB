meta {
  name: 08-03 Setup Vault And Email
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{advancedUsername}}",
    "password": "{{advancedPassword}}"
  }
}

script:post-response {
  bru.setVar("advancedSessionToken", res.body.data.session_token);
}

assert {
  res.status: eq 200
}

docs {
  **Endpoint:** `POST /api/v1/auth/login`

  **This test verifies:** Login before vault and recovery email setup.
}
