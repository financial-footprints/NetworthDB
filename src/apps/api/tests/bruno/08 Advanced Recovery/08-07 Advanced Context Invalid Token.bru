meta {
  name: 08-07 Advanced Context Invalid Token
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/v1/auth/recovery/advanced/context
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-valid-advanced-token"
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}

docs {
  **Endpoint:** `POST /api/v1/auth/recovery/advanced/context`

  **This test verifies:** Invalid advanced recovery token returns 400.
}
