meta {
  name: 08-05 Initialize Password Vault
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/v1/users/me/vault/initialize
  body: json
  auth: bearer
}

auth:bearer {
  token: {{advancedSessionToken}}
}

body:json {
  {
    "slots": [
      {
        "slot_type": "password",
        "salt": "AQIDBAUGBwgJCgsMDQ4PEA",
        "wrap_blob": "abc.def",
        "password": "{{advancedPassword}}"
      }
    ]
  }
}

assert {
  res.status: eq 201
}

docs {
  **Endpoint:** `POST /api/v1/users/me/vault/initialize`

  **This test verifies:** Initialize password-only vault for advanced recovery.
}
