# Stdio MCP host for Cursor; make dev runs MCP_TRANSPORT=http on PORT (default 8002).
# Cursor loads this file via .cursor/mcp.json envFile.
# Manual run: bun --env-file .env src/index.ts
LOG_LEVEL=info
ENVIRONMENT=local
API_ORIGIN=http://127.0.0.1:8000

# MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# HOST=127.0.0.1
# PORT=8002

# Postgres (read-only MCP SQL pool; migrate creates the role from API env).
POSTGRES_HOST=localhost
POSTGRES_PORT=5451
POSTGRES_DATABASE=networthdb
POSTGRES_SSLMODE=disable
POSTGRES_RO_USER=networthdb_readonly
POSTGRES_RO_PASSWORD=networthdb_readonly

# Optional startup login (do not commit real passwords).
# NDB_USERNAME=usher
# NDB_PASSWORD=admin
# NDB_TOTP=
