{
  "name": "@ndb/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./exports.d.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "native.d.ts",
    "exports.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "logger",
    "constEnum": false
  },
  "scripts": {
    "build": "napi build --release --no-js --dts native.d.ts --manifest-path ../../../Cargo.toml --package logger",
    "build:debug": "napi build --no-js --dts native.d.ts --manifest-path ../../../Cargo.toml --package logger",
    "dev": "bash scripts/dev.sh",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.1",
    "@types/node": "^26.4.1",
    "typescript": "~7.0.2"
  }
}
