{
  "name": "@ndb/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "bash scripts/migration.sh",
    "migrate": "bun --env-file ../../apps/api/.env drizzle-kit migrate && bun --env-file ../../apps/api/.env scripts/seed.ts",
    "migrate:test": "bun --env-file ../../apps/api/.env.tests drizzle-kit migrate && bun --env-file ../../apps/api/.env.tests scripts/seed.ts",
    "seed": "bun --env-file ../../apps/api/.env scripts/seed.ts",
    "test": "bun test --env-file ../../apps/api/.env.tests ./tests",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ndb/auth": "workspace:*",
    "@ndb/core": "workspace:*",
    "@ndb/encryption": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "~7.0.2"
  }
}
